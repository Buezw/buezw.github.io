      <title>Calculus 10. Parametric Equations and Polar Coordinates</title>
      <link>https://buezw.github.io/docs/uoft/24f/mat186---calculus/calculus10.parametricequationsandpolarcoordinates/</link>
      <pubDate>Wed, 08 Jan 2025 00:00:00 +0000</pubDate>
      <author>youremail@example.com (Buezwqwg)</author>
